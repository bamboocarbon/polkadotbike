{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polkadotbike",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /about serves out/about.html, /climbs/x serves out/climbs/x.html.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get Next's generated 404 page with a real 404 status.
    "not_found_handling": "404-page",
    // Only /api/geo runs the Worker; everything else is plain static.
    "run_worker_first": ["/api/geo"]
  },
  "routes": [
    { "pattern": "polkadotbike.com", "custom_domain": true },
    { "pattern": "www.polkadotbike.com", "custom_domain": true }
  ]
}
